# Copie este arquivo para .env e preencha com os seus valores.
# O .env NÃO é versionado (está no .gitignore).

# Gere uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados: mysql (padrão) ou sqlite (para testes e demonstração rápida)
DB_ENGINE=mysql
DB_NAME=cadastro_clientes
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_HOST=localhost
DB_PORT=3306
